{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oracle-tarot-v1",
  "compatibility_date": "2026-05-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [".git", ".git/**", "node_modules", "node_modules/**"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
